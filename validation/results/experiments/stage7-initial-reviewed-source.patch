diff --git a/cbits/gssapi.c b/cbits/gssapi.c
new file mode 100644
index 0000000..5f6efec
--- /dev/null
+++ b/cbits/gssapi.c
@@ -0,0 +1,94 @@
+/* A small ownership boundary around the platform GSSAPI ABI. All calls for one
+ * context run on its Haskell worker. Output remains owned by that context until
+ * the next step or close; Haskell copies it before making another request. */
+#ifdef _WIN32
+unsigned int mariadb_gss_live_contexts(void) { return 0; }
+#else
+#ifdef __APPLE__
+#include <GSS/GSS.h>
+#else
+#include <gssapi/gssapi.h>
+#endif
+#include <stdlib.h>
+#include <stdatomic.h>
+
+/* A credential-free diagnostic also used by cancellation/leak regressions. */
+static _Atomic unsigned int live_contexts = 0;
+unsigned int mariadb_gss_live_contexts(void) { return atomic_load(&live_contexts); }
+
+struct mariadb_gss_context {
+    gss_name_t service;
+    gss_ctx_id_t context;
+    gss_buffer_desc output;
+    gss_OID_desc mechanism;
+    int counted;
+};
+
+void mariadb_gss_close(struct mariadb_gss_context *state)
+{
+    OM_uint32 minor;
+    if (!state) return;
+    if (state->output.value) gss_release_buffer(&minor, &state->output);
+    if (state->context != GSS_C_NO_CONTEXT)
+        gss_delete_sec_context(&minor, &state->context, GSS_C_NO_BUFFER);
+    if (state->service != GSS_C_NO_NAME)
+        gss_release_name(&minor, &state->service);
+    if (state->counted) atomic_fetch_sub(&live_contexts, 1);
+    free(state);
+}
+
+int mariadb_gss_open(const char *principal, size_t length, int negotiate,
+                     struct mariadb_gss_context **result,
+                     OM_uint32 *major, OM_uint32 *minor)
+{
+    static unsigned char kerberos[] = {0x2a,0x86,0x48,0x86,0xf7,0x12,0x01,0x02,0x02};
+    static unsigned char spnego[] = {0x2b,0x06,0x01,0x05,0x05,0x02};
+    struct mariadb_gss_context *state = calloc(1, sizeof(*state));
+    gss_buffer_desc name = {length, (void *)principal};
+    *result = NULL;
+    *major = *minor = 0;
+    if (!state) return 1;
+    state->service = GSS_C_NO_NAME;
+    state->context = GSS_C_NO_CONTEXT;
+    state->mechanism.length = negotiate ? sizeof(spnego) : sizeof(kerberos);
+    state->mechanism.elements = negotiate ? spnego : kerberos;
+    *major = gss_import_name(minor, &name, GSS_C_NT_USER_NAME, &state->service);
+    if (GSS_ERROR(*major)) {
+        mariadb_gss_close(state);
+        return 2;
+    }
+    state->counted = 1;
+    atomic_fetch_add(&live_contexts, 1);
+    *result = state;
+    return 0;
+}
+
+int mariadb_gss_step(struct mariadb_gss_context *state,
+                     const char *input, size_t length,
+                     const char **output, size_t *output_length, int *complete,
+                     OM_uint32 *major, OM_uint32 *minor)
+{
+    OM_uint32 flags = 0, ignored;
+    gss_buffer_desc token = {length, (void *)input};
+    if (state->output.value) gss_release_buffer(&ignored, &state->output);
+    state->output.value = NULL;
+    state->output.length = 0;
+    *output = NULL;
+    *output_length = 0;
+    *complete = 0;
+    /* No delegation: the server receives a service ticket, never a TGT. Mutual
+     * authentication binds its reply to the explicitly pinned principal. */
+    *major = gss_init_sec_context(minor, GSS_C_NO_CREDENTIAL, &state->context,
+        state->service, &state->mechanism, GSS_C_MUTUAL_FLAG, 0,
+        GSS_C_NO_CHANNEL_BINDINGS, length ? &token : GSS_C_NO_BUFFER,
+        NULL, &state->output, &flags, NULL);
+    if (GSS_ERROR(*major)) return 2;
+    if (state->output.length > 1048576) return 3;
+    *complete = (*major & GSS_S_CONTINUE_NEEDED) == 0;
+    if (*complete && !(flags & GSS_C_MUTUAL_FLAG)) return 4;
+    *output = state->output.value;
+    *output_length = state->output.length;
+    return 0;
+}
+
+#endif /* !_WIN32 */
diff --git a/src/Database/MySQL/Authentication.hs b/src/Database/MySQL/Authentication.hs
new file mode 100644
index 0000000..3a40cb6
--- /dev/null
+++ b/src/Database/MySQL/Authentication.hs
@@ -0,0 +1,46 @@
+-- | Explicit external authentication settings. PAM replies are cleartext and
+-- require TLS or a Unix socket. GSSAPI uses existing system credentials, never
+-- the SQL password, and requires an exact expected server principal.
+module Database.MySQL.Authentication
+    ( AuthenticationOptions(..)
+    , defaultAuthenticationOptions
+    , DialogPrompt(..)
+    , passwordDialog
+    ) where
+
+import Data.ByteString (ByteString)
+
+-- | Authentication-only settings, discarded after establishment. Callbacks run
+-- on the connecting thread under the connection deadline; exceptions propagate
+-- and close the transport. Do not log their replies or the SQL credentials.
+data AuthenticationOptions = AuthenticationOptions
+    { authenticationDialog :: Maybe (DialogPrompt -> IO ByteString)
+      -- ^ Opt in to PAM/dialog and clear-password replies. No terminal fallback.
+    , authenticationGSSAPIPrincipal :: Maybe ByteString
+      -- ^ Exact Kerberos service principal expected from MariaDB, including realm.
+      -- Native GSSAPI requires an application built with @-threaded@ so a KDC
+      -- call cannot prevent the connection deadline or cancellation handler.
+    }
+
+-- | Disable external credential use until the application opts in explicitly.
+defaultAuthenticationOptions :: AuthenticationOptions
+defaultAuthenticationOptions = AuthenticationOptions Nothing Nothing
+
+-- | One MariaDB dialog question. Text is the server's uninterpreted prompt,
+-- without its terminal NUL. Round numbers start at zero. A final question still
+-- requires the server's OK before authentication succeeds.
+data DialogPrompt = DialogPrompt
+    { dialogText :: !ByteString
+    , dialogEcho :: !Bool
+    , dialogLast :: !Bool
+    , dialogRound :: !Int
+    } deriving (Eq, Show)
+
+-- | A noninteractive single-password PAM callback. Only the first hidden prompt
+-- is accepted; a PIN, username or second factor needs an application callback.
+-- Embedded NUL and response-size checks are applied by the authentication loop.
+passwordDialog :: ByteString -> DialogPrompt -> IO ByteString
+passwordDialog password prompt
+    | not (dialogEcho prompt) && dialogRound prompt == 0 = pure password
+    | otherwise = ioError (userError "PAM requires an application dialog callback")
+
diff --git a/src/Database/MySQL/Authentication/GSSAPI.hs b/src/Database/MySQL/Authentication/GSSAPI.hs
new file mode 100644
index 0000000..10c05a6
--- /dev/null
+++ b/src/Database/MySQL/Authentication/GSSAPI.hs
@@ -0,0 +1,112 @@
+{-# LANGUAGE CPP #-}
+{-# LANGUAGE ForeignFunctionInterface #-}
+{-# LANGUAGE ScopedTypeVariables #-}
+-- | Internal platform provider. SQL transport and authentication policy remain
+-- in Connection; this module owns only native context lifetime and token steps.
+module Database.MySQL.Authentication.GSSAPI (GSSAPIError(..), withGSSAPI) where
+
+import Control.Exception
+import Data.ByteString (ByteString)
+
+#ifndef mingw32_HOST_OS
+import Control.Concurrent
+import Control.Monad
+import qualified Data.ByteString as B
+import Foreign hiding (void)
+import Foreign.C.Types
+
+#endif
+
+newtype GSSAPIError = GSSAPIError String deriving Show
+instance Exception GSSAPIError
+
+#ifdef mingw32_HOST_OS
+-- Windows needs an SSPI provider; do not fail every ordinary-driver build by
+-- attempting to link Unix GSSAPI libraries on that platform.
+withGSSAPI :: ByteString -> Bool -> ((ByteString -> IO (Bool, ByteString)) -> IO a) -> IO a
+withGSSAPI _ _ _ = throwIO (GSSAPIError "native GSSAPI requires a Unix platform provider")
+#else
+-- A worker is the sole owner of native state. Cancelling the connecting thread
+-- enqueues Stop without waiting for a potentially blocking KDC request. The
+-- worker finishes that request, releases its context and exits; it has no socket
+-- access and cannot continue authentication after the caller's transport closes.
+-- This also prevents a finalizer racing gss_init_sec_context in a safe FFI call.
+data Request = Step ByteString (MVar (Either SomeException (Bool, ByteString))) | Stop
+data NativeContext
+
+foreign import ccall safe "mariadb_gss_open"
+    nativeOpen :: Ptr CChar -> CSize -> CInt -> Ptr (Ptr NativeContext)
+               -> Ptr Word32 -> Ptr Word32 -> IO CInt
+foreign import ccall safe "mariadb_gss_step"
+    nativeStep :: Ptr NativeContext -> Ptr CChar -> CSize -> Ptr (Ptr CChar)
+               -> Ptr CSize -> Ptr CInt -> Ptr Word32 -> Ptr Word32 -> IO CInt
+foreign import ccall safe "mariadb_gss_close"
+    nativeClose :: Ptr NativeContext -> IO ()
+
+-- | Internal provider boundary. One serialized step yields completion plus an
+-- owned token copy. All output is bounded to 1 MiB. Native work already in
+-- progress can outlive cancellation, subject to the OS Kerberos retry policy;
+-- cancellation itself never waits for it and never exposes the socket to it.
+withGSSAPI :: ByteString -> Bool -> ((ByteString -> IO (Bool, ByteString)) -> IO a) -> IO a
+withGSSAPI principal negotiate action = mask $ \restore -> do
+    -- A non-threaded RTS cannot run the timeout handler while another Haskell
+    -- thread is inside a safe foreign call. Fail before acquiring credentials
+    -- rather than silently weakening the connection deadline.
+    unless rtsSupportsBoundThreads
+        (throwIO (GSSAPIError "GSSAPI authentication requires an application built with -threaded"))
+    requests <- newEmptyMVar
+    ready <- newEmptyMVar
+    _ <- forkIO $ do
+        opened <- try (openContext principal negotiate)
+        putMVar ready opened
+        case opened of
+            Left (_ :: SomeException) -> pure ()
+            Right context -> worker requests context `finally` nativeClose context
+    -- A cancelled caller can leave Step in the single-slot queue. Queue Stop
+    -- from a helper rather than dropping it or blocking connection cleanup.
+    let stop = void (forkIO (putMVar requests Stop))
+        step token = do
+            reply <- newEmptyMVar
+            putMVar requests (Step token reply)
+            takeMVar reply >>= either throwIO pure
+    flip finally stop $ do
+        restore (takeMVar ready) >>= either throwIO (const (pure ()))
+        restore (action step)
+  where
+    worker requests context = do
+        request <- takeMVar requests
+        case request of
+            Stop -> pure ()
+            Step token reply -> do
+                result <- try (stepContext context token)
+                putMVar reply result
+                worker requests context
+
+openContext :: ByteString -> Bool -> IO (Ptr NativeContext)
+openContext principal negotiate = B.useAsCStringLen principal $ \(name,size) ->
+    alloca $ \result -> alloca $ \major -> alloca $ \minor -> do
+        status <- nativeOpen name (fromIntegral size) (if negotiate then 1 else 0) result major minor
+        checkNative status major minor
+        peek result
+
+stepContext :: Ptr NativeContext -> ByteString -> IO (Bool, ByteString)
+stepContext context token = B.useAsCStringLen token $ \(input,size) ->
+    alloca $ \output -> alloca $ \lengthPtr -> alloca $ \complete ->
+    alloca $ \major -> alloca $ \minor -> do
+        status <- nativeStep context input (fromIntegral size) output lengthPtr complete major minor
+        checkNative status major minor
+        count <- fromIntegral <$> peek lengthPtr
+        bytes <- if count == 0 then pure B.empty else peek output >>= \ptr -> B.packCStringLen (ptr,count)
+        done <- (/= 0) <$> peek complete
+        pure (done,bytes)
+
+checkNative :: CInt -> Ptr Word32 -> Ptr Word32 -> IO ()
+checkNative status major minor = unless (status == 0) $ do
+    majorCode <- peek major
+    minorCode <- peek minor
+    -- Numeric provider codes retain diagnostics without logging ticket bodies,
+    -- credentials, cache names or server-controlled challenge text.
+    throwIO (GSSAPIError ("GSSAPI authentication failed (status " ++ show status ++
+        ", major " ++ show majorCode ++ ", minor " ++ show minorCode ++ ")"))
+
+#endif
