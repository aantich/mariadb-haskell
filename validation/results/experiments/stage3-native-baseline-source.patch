+#!/usr/bin/env python3
+"""Measure additive native features against alternatives on the same build.
+
+This never replaces or edits the frozen benchmark enumeration or its results.
+A new output directory is required; every process log and sample is retained.
+"""
+import argparse
+import json
+import hashlib
+import os
+import platform
+from pathlib import Path
+import random
+import statistics
+
+import publish_results as live
+import run
+
+PROFILES = {
+    'bulk.native': 5, 'bulk.units': 5, 'bulk.prepared': 5, 'bulk.text-batch': 5,
+    'prepared.narrow.cached': 500, 'prepared.narrow.uncached': 500,
+    'prepared.wide.cached': 500, 'prepared.wide.uncached': 500,
+}
+PAIRS = {
+    'native_vs_sequential': ('bulk.native', 'bulk.prepared'),
+    'native_vs_text_batch': ('bulk.native', 'bulk.text-batch'),
+    'unit_vs_aggregate': ('bulk.units', 'bulk.native'),
+    'cached_vs_uncached_narrow': ('prepared.narrow.cached', 'prepared.narrow.uncached'),
+    'cached_vs_uncached_wide': ('prepared.wide.cached', 'prepared.wide.uncached'),
+}
+
+
+def sample(output, ident):
+    """Require one complete record, positive work and the independent checksum."""
+    lines = [line for line in output.splitlines() if line.startswith('STAGE3\t')]
+    if len(lines) != 1:
+        raise ValueError('expected exactly one native benchmark record')
+    marker, name, *values = lines[0].split('\t')
+    if marker != 'STAGE3' or name != ident or len(values) != 6:
+        raise ValueError('native benchmark record shape/identity mismatch')
+    result = dict(zip(('units', 'elapsed_ns', 'allocated_bytes', 'cpu_ns', 'gc_cpu_ns', 'checksum'), map(int, values)))
+    if result['units'] <= 0 or result['elapsed_ns'] <= 0 or any(value < 0 for value in result.values()):
+        raise ValueError('invalid native benchmark counters')
+    iterations = PROFILES[ident]
+    expected = iterations * (629500 if ident.startswith('bulk.') else 3847 if '.wide.' in ident else 7)
+    if result['checksum'] != expected:
+        raise ValueError('native benchmark checksum mismatch')
+    expected_units = iterations * (1000 if ident.startswith('bulk.') else 1)
+    if result['units'] != expected_units:
+        raise ValueError('native benchmark unit count mismatch')
+    return result
+
+
+def verify_evidence(data, inputs):
+    """Reject missing/stale/partial native evidence before live publication."""
+    if (not data.get('complete') or data.get('repetitions', 0) < 7
+            or data.get('inputs', {}).get('sha256') != inputs['sha256']):
+        raise ValueError('native benchmark evidence is incomplete or stale')
+    if set(data.get('profiles', {})) != set(PROFILES):
+        raise ValueError('native benchmark profiles are incomplete')
+    keys = ('units', 'elapsed_ns', 'allocated_bytes', 'cpu_ns', 'gc_cpu_ns', 'checksum')
+    for ident, profile in data['profiles'].items():
+        if len(profile.get('samples', [])) != data['repetitions']:
+            raise ValueError('native benchmark repetitions are incomplete')
+        for entry in profile['samples']:
+            sample('STAGE3\t' + ident + '\t' + '\t'.join(str(entry[k]) for k in keys), ident)
+        for key in keys[1:-1]:
+            expected = statistics.median(s[key] / s['units'] for s in profile['samples'])
+            if profile.get('median_' + key + '_per_unit') != expected:
+                raise ValueError('native benchmark summary disagrees with samples')
+
+    if set(data.get('comparisons', {})) != set(PAIRS):
+        raise ValueError('native comparison profiles are incomplete')
+    for name, (candidate, reference) in PAIRS.items():
+        pair = data['comparisons'][name]
+        if pair.get('current') != candidate or pair.get('baseline') != reference:
+            raise ValueError('native comparison identity mismatch')
+        for key in ('elapsed_ns', 'allocated_bytes'):
+            expected = 100 * (data['profiles'][candidate]['median_' + key + '_per_unit'] /
+                              data['profiles'][reference]['median_' + key + '_per_unit'] - 1)
+            if pair.get('change_percent', {}).get(key) != expected:
+                raise ValueError('native comparison disagrees with samples')
+
+
+def compare_native_baseline(data):
+    """Use the first immutable native-feature capture only on a matching profile."""
+    baseline_path = run.HERE / 'baselines/macos-arm64-native-statements/results.json'
+    if not baseline_path.exists():
+        return
+    raw = baseline_path.read_bytes()
+    expected_hash = (baseline_path.parent / 'SHA256SUMS').read_text().split()[0]
+    if hashlib.sha256(raw).hexdigest() != expected_hash:
+        raise ValueError('native baseline checksum mismatch')
+    baseline = json.loads(raw)
+    workload_paths = ['validation/hs/Validation/Stage3Bench.hs', 'validation/hs/Validation/Common.hs', 'validation/stage3_benchmarks.py']
+    same = (all(data[key] == baseline[key] for key in ('server', 'machine', 'dependencies', 'haskell_benchmark_rts'))
+            and all(data['build'][key] == baseline['build'][key] for key in ('ghc', 'cabal'))
+            and all(data['inputs']['files'][key] == baseline['inputs']['files'][key] for key in workload_paths))
+    comparison = {'reference': live.relative(baseline_path), 'sha256': expected_hash, 'comparable': same,
+                  'timing_investigations': [], 'allocation_investigations': [], 'profiles': {}}
+    if same:
+        for ident, profile in data['profiles'].items():
+            old = baseline['profiles'][ident]
+            changes = {key: 100 * (profile['median_' + key + '_per_unit'] / old['median_' + key + '_per_unit'] - 1)
+                       for key in ('elapsed_ns', 'allocated_bytes')}
+            comparison['profiles'][ident] = changes
+            for metric, category in [('elapsed_ns', 'timing_investigations'), ('allocated_bytes', 'allocation_investigations')]:
+                if changes[metric] > 5:
+                    comparison[category].append({'id': ident, 'percent': changes[metric]})
+    data['baseline_comparison'] = comparison
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--config', type=Path, default=run.HERE / '.local/environment.json')
+    parser.add_argument('--repetitions', type=int, default=7)
+    args = parser.parse_args()
+    if args.repetitions < 7:
+        parser.error('native confirmation requires at least seven process repetitions')
+    if args.output.exists():
+        parser.error('output directory exists; previous evidence must be retained')
+    env = os.environ.copy()
+    env.update(json.loads(args.config.read_text()))
+    env['TZ'] = 'UTC'
+    version = run.sql_client(env, 'SELECT VERSION()')
+    if 'MariaDB' not in version:
+        raise RuntimeError('expected MariaDB before build')
+    inputs = live.input_snapshot()
+    run.command(['cabal', 'build', 'exe:mariadb-validation', '-O2', '--enable-tests'], timeout=300)
+    if any(live.input_snapshot()[key] != inputs[key] for key in ('files', 'commit')):
+        raise RuntimeError('inputs changed during native benchmark build')
+    binary = run.executable('exe:mariadb-validation')
+    args.output.mkdir(parents=True)
+    plan = json.loads((run.ROOT / 'dist-newstyle/cache/plan.json').read_text())
+    dependencies = sorted({(p['pkg-name'], p['pkg-version']) for p in plan['install-plan'] if p['pkg-name'] != 'mysql-haskell'})
+    data = {'schema': 1, 'recorded_at': live.now(), 'inputs': inputs,
+            'server': run.server_metadata(env), 'repetitions': args.repetitions,
+            'build': run.snapshot(), 'haskell_benchmark_rts': ['-N4', '-T'],
+            'dependencies': dependencies,
+            'dependency_plan_sha256': hashlib.sha256(json.dumps(dependencies).encode()).hexdigest(),
+            'machine': {'system': platform.system(), 'release': platform.release(),
+                        'machine': platform.machine(), 'processor': platform.processor(), 'cpu_count': os.cpu_count()},
+            'policy': 'two in-process warmups; shuffled independent processes; same-build alternatives; all samples retained',
+            'profiles': {ident: {'samples': []} for ident in PROFILES}, 'complete': False}
+    destination = args.output / 'results.json'
+    try:
+        for repetition in range(args.repetitions):
+            order = list(PROFILES)
+            random.Random(20261107 + repetition).shuffle(order)
+            for ident in order:
+                output = run.command([binary, 'stage3-bench', ident, str(PROFILES[ident]),
+                                      '+RTS', '-N4', '-T', '-RTS'], env=env, timeout=180, check=False)
+                (args.output / f'{ident}.{repetition}.log').write_text(output.stdout + output.stderr)
+                if output.returncode:
+                    raise RuntimeError('native benchmark process failed: ' + ident)
+                data['profiles'][ident]['samples'].append(sample(output.stdout, ident))
+                print('NATIVE', repetition + 1, ident, flush=True)
+        for profile in data['profiles'].values():
+            for key in ('elapsed_ns', 'allocated_bytes', 'cpu_ns', 'gc_cpu_ns'):
+                profile['median_' + key + '_per_unit'] = statistics.median(s[key] / s['units'] for s in profile['samples'])
+        data['comparisons'] = {}
+        for name, (candidate, reference) in PAIRS.items():
+            data['comparisons'][name] = {'current': candidate, 'baseline': reference,
+                'change_percent': {key: 100 * (data['profiles'][candidate]['median_' + key + '_per_unit'] /
+                    data['profiles'][reference]['median_' + key + '_per_unit'] - 1)
+                    for key in ('elapsed_ns', 'allocated_bytes')}}
+        if any(live.input_snapshot()[key] != inputs[key] for key in ('files', 'commit')):
+            raise RuntimeError('inputs changed during native benchmark measurement')
+        data['complete'] = True
+        verify_evidence(data, inputs)
+        compare_native_baseline(data)
+    except Exception as error:
+        data['complete'] = False
+        data['error'] = str(error)
+        raise
+    finally:
+        destination.write_text(json.dumps(data, indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
