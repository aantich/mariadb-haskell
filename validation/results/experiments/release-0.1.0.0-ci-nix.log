2026-11-09T15:33:32.0787686Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-09T15:33:32.0787818Z 
2026-11-09T15:33:32.0787930Z # To enable the settings / commands in this file for login shells as well,
2026-11-09T15:33:32.0788183Z # this file has to be sourced in /etc/profile.
2026-11-09T15:33:32.0788296Z 
2026-11-09T15:33:32.0788379Z # If not running interactively, don't do anything
2026-11-09T15:33:32.0788556Z [ -z "${PS1-}" ] && return
2026-11-09T15:33:32.0788642Z 
2026-11-09T15:33:32.0788733Z # check the window size after each command and, if necessary,
2026-11-09T15:33:32.0788923Z # update the values of LINES and COLUMNS.
2026-11-09T15:33:32.0789078Z shopt -s checkwinsize
2026-11-09T15:33:32.0789161Z 
2026-11-09T15:33:32.0789279Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-09T15:33:32.0789532Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-09T15:33:32.0789723Z     debian_chroot=$(< /etc/debian_chroot)
2026-11-09T15:33:32.0789866Z fi
2026-11-09T15:33:32.0789927Z 
2026-11-09T15:33:32.0790027Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-09T15:33:32.0790267Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-09T15:33:32.0790528Z if ! [ -n "${SUDO_USER-}" -a -n "${SUDO_PS1-}" ]; then
2026-11-09T15:33:32.0790724Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-09T15:33:32.0790879Z fi
2026-11-09T15:33:32.0790941Z 
2026-11-09T15:33:32.0790996Z case "$TERM" in
2026-11-09T15:33:32.0791116Z xterm*|vte*|gnome*)
2026-11-09T15:33:32.0791264Z     for _hook in /etc/profile.d/vte*.sh; do : ; done
2026-11-09T15:33:32.0791436Z     if [ -r $_hook ]; then
2026-11-09T15:33:32.0791566Z         . $_hook
2026-11-09T15:33:32.0791674Z     fi
2026-11-09T15:33:32.0791781Z     unset _hook
2026-11-09T15:33:32.0791888Z     ;;
2026-11-09T15:33:32.0791992Z xterm*|rxvt*)
2026-11-09T15:33:32.0792176Z     # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-09T15:33:32.0792424Z     # If this is an xterm set the title to user@host:dir
2026-11-09T15:33:32.0792645Z     #PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-09T15:33:32.0792836Z     ;;
2026-11-09T15:33:32.0792936Z *)
2026-11-09T15:33:32.0793034Z     ;;
2026-11-09T15:33:32.0793132Z esac
2026-11-09T15:33:32.0793193Z 
2026-11-09T15:33:32.0793426Z # enable bash completion in interactive shells
2026-11-09T15:33:32.0793606Z #if ! shopt -oq posix; then
2026-11-09T15:33:32.0793782Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-09T15:33:32.0793980Z #    . /usr/share/bash-completion/bash_completion
2026-11-09T15:33:32.0794153Z #  elif [ -f /etc/bash_completion ]; then
2026-11-09T15:33:32.0794415Z #    . /etc/bash_completion
2026-11-09T15:33:32.0794541Z #  fi
2026-11-09T15:33:32.0794642Z #fi
2026-11-09T15:33:32.0794697Z 
2026-11-09T15:33:32.0794782Z # if the command-not-found package is installed, use it
2026-11-09T15:33:32.0795055Z if [ -x /usr/lib/command-not-found ] || [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-09T15:33:32.0795305Z 	function command_not_found_handle {
2026-11-09T15:33:32.0795656Z 	        # check because c-n-f could've been removed in the meantime
2026-11-09T15:33:32.0795862Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-09T15:33:32.0796045Z 		   /usr/lib/command-not-found -- "$1"
2026-11-09T15:33:32.0796203Z                    return $?
2026-11-09T15:33:32.0796383Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-09T15:33:32.0796609Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-09T15:33:32.0796788Z                    return $?
2026-11-09T15:33:32.0796916Z 		else
2026-11-09T15:33:32.0797038Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-09T15:33:32.0797190Z 		   return 127
2026-11-09T15:33:32.0797299Z 		fi
